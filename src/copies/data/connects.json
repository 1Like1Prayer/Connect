  "detailsByConnectId": {
    "1": {
      "description": "Regular Tuesday game, same crowd most weeks, and we are two short tonight. Half-pitch, rolling subs, nobody keeps score after the first ten minutes. Turn up ten minutes early if you want a proper warm-up.",
      "whatToBring": "A dark shirt and a light one — we sort teams on the spot. Boots or trainers both fine on this surface. Water; the fountain by the car park has been broken for a month.",
      "venueName": "Park HaYarkon, pitch 3",
      "meetingInstructions": "The gate beside the tennis courts, not the main entrance. Look for the lime kit bag.",
      "pricing": {
        "costType": "split",
        "totalAmount": 200,
        "amountPerPerson": 20,
        "expenseDescription": "the pitch"
      }
    },
    "2": {
      "description": "Three of us play most weeks and one dropped out. Standard Catan, no expansions, we explain the rules properly if you have never played. Beer in the fridge, cat on the sofa.",
      "whatToBring": "Nothing. If you want something specific to drink, bring it — otherwise there is beer and mint tea.",
      "venueName": "Flat 4, Florentin",
      "meetingInstructions": "Ring the buzzer marked Shalev. Third floor, no lift, sorry.",
      "pricing": {
        "costType": "free"
      }
    },
    "3": {
      "description": "Indoor bouldering, mostly V2 to V5. We are not a class — everyone works their own problems and we spot each other. Good session if you have been climbing a few months and want people to climb with.",
      "whatToBring": "Shoes if you own them, otherwise rental is ₪25 at the desk. Chalk gets shared.",
      "venueName": "Yad Eliyahu climbing gym",
      "meetingInstructions": "By the shoe rental desk at the entrance.",
      "pricing": {
        "costType": "ticketed",
        "amountPerPerson": 65
      }
    },
    "4": {
      "description": "Chungking Express then Fallen Angels, projected onto the wall of my roof. Starts once it is properly dark. Subtitles in English.",
      "whatToBring": "A cushion or a folding chair — the roof is concrete. Something to share if you feel like it.",
      "venueName": "Rooftop, Kerem HaTeimanim",
      "meetingInstructions": "The blue door on the corner, then all the way up the stairs.",
      "pricing": {
        "costType": "free"
      }
    },
    "5": {
      "description": "Easy 6 km along the water and back, conversational pace, nobody gets dropped. We leave at 06:45 sharp because some of us start work at eight.",
      "whatToBring": "Just yourself. There is a water fountain at the turnaround point.",
      "venueName": "Gordon Beach promenade",
      "meetingInstructions": "The lifeguard tower at the top of the ramp.",
      "pricing": {
        "costType": "free"
      }
    },
    "6": {
      "description": "Slow vinyasa on the grass, about an hour, suitable if you have done a few classes before. Dana teaches; the rest of us just show up.",
      "whatToBring": "A mat, or a towel if you do not have one. The grass is soft enough either way.",
      "venueName": "Old North, the lawn by the playground",
      "meetingInstructions": "The bench under the big ficus.",
      "pricing": {
        "costType": "split",
        "totalAmount": 180,
        "amountPerPerson": 15,
        "expenseDescription": "the teacher fee"
      }
    },
    "7": {
      "description": "Half an hour of Hebrew, half an hour of Spanish, then whoever wants to stay stays. All levels — the beginners table is usually the loudest one.",
      "whatToBring": "Nothing. Buy a coffee if you can, the café lets us take over the back room.",
      "venueName": "Café in Neve Tzedek",
      "meetingInstructions": "Back room, look for the table with the little flags on it.",
      "pricing": {
        "costType": "free"
      }
    },
    "8": {
      "description": "Four stops down Rothschild, starting early enough to get a seat. We move as a group but nobody minds if you peel off after two.",
      "whatToBring": "ID. Two of the stops card everyone at the door.",
      "venueName": "Rothschild Boulevard",
      "meetingInstructions": "Outside Port Said, by the record crates.",
      "pricing": {
        "costType": "own"
      }
    },
    "9": {
      "description": "Bring whatever you are stuck on — side project, work thing, something you are learning. Quiet for the first two hours, then it gets social. Some of us just read.",
      "whatToBring": "Laptop and a charger. There are only four sockets, so a short extension lead earns you friends.",
      "venueName": "Sarona, the co-working lounge",
      "meetingInstructions": "Ground floor lounge, ask for the Connect table at reception.",
      "pricing": {
        "costType": "free"
      }
    },
    "10": {
      "description": "Blanket on the grass, watch the sun go down over the river, go home at a reasonable hour. Kids and dogs both welcome.",
      "whatToBring": "Something to share and something to sit on. Somebody always forgets a bottle opener.",
      "venueName": "Park HaYarkon, the lawn by the boat rental",
      "meetingInstructions": "The willow tree between the boat rental and the bridge.",
      "pricing": {
        "costType": "free"
      }
    },
    "11": {
      "description": "Two hours wandering old Jaffa while the light is good, stopping wherever people want to shoot. Not a workshop — nobody is teaching, we just walk and photograph.",
      "whatToBring": "Whatever camera you have, phone included. Comfortable shoes; the stones are uneven.",
      "venueName": "Old Jaffa",
      "meetingInstructions": "The clock tower, by the steps on the south side.",
      "pricing": {
        "costType": "free"
      }
    },
    "12": {
      "description": "Toddlers run around, parents drink coffee and talk to adults for an hour. Ages roughly one to four. No structure whatsoever.",
      "whatToBring": "Snacks for your own child, and a spare set of clothes — the sandpit is the sandpit.",
      "venueName": "Ramat Aviv playground",
      "meetingInstructions": "The benches by the small slide.",
      "pricing": {
        "costType": "free"
      }
    },
    "13": {
      "description": "One-shot adventure, pre-made characters, roughly four hours including a break. Built for people who have never played a tabletop RPG before but are curious.",
      "whatToBring": "Nothing at all. Dice and character sheets are provided.",
      "venueName": "Flat above the bakery, Florentin",
      "meetingInstructions": "Side entrance on the alley, second floor.",
      "pricing": {
        "costType": "free"
      }
    },
    "14": {
      "description": "Easy hour along the port with the dogs, one coffee stop halfway. Friendly dogs only, and everyone stays on a lead near the boardwalk.",
      "whatToBring": "Water for your dog and bags. There is a tap by the coffee kiosk.",
      "venueName": "Tel Aviv Port",
      "meetingInstructions": "The kiosk at the north end of the boardwalk.",
      "pricing": {
        "costType": "free"
      }
    }
  },
